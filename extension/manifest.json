{
  "manifest_version": 3,
  "name": "Tab Butler",
  "version": "0.1.0",
  "description": "Auto-bundles tabs, safely archives idle ones, and is made smart by Claude. Local-first; Claude is opt-in.",
  "permissions": ["tabs", "tabGroups", "alarms", "idle", "storage", "sessions", "bookmarks", "system.memory"],
  "host_permissions": [
    "http://localhost:3210/*",
    "https://YOUR-PROXY.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Butler"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
